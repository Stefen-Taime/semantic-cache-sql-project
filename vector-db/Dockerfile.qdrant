FROM qdrant/qdrant:latest

# Installer Python et requests
RUN apt-get update && \
    apt-get install -y python3-requests curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copier les scripts
COPY init_qdrant.py /init_qdrant.py

# Commande par défaut (simplement démarrer Qdrant)
CMD ["./qdrant"]